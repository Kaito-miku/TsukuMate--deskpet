{
  "name": "tsukumate",
  "version": "0.11.0",
  "description": "TsukuMate — a local-first AI desktop companion.",
  "main": "src/main/index.js",
  "scripts": {
    "start": "node launch.js",
    "build": "electron-builder --win",
    "build:win:x64": "electron-builder --win nsis:x64",
    "build:win:arm64": "electron-builder --win nsis:arm64",
    "build:win:all": "electron-builder --win nsis:x64 nsis:arm64",
    "build:mac": "electron-builder --mac",
    "build:mac:mvp": "electron-builder --mac --arm64 -c.mac.target=dmg",
    "build:mac:repack": "electron-builder --mac --arm64 -c.mac.target=dmg",
    "build:mac:notarize": "bash scripts/build-dmg-notarize.sh",
    "build:mac:mvp:notarize": "bash scripts/build-dmg-notarize.sh",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --mac --linux",
    "fetch:sidecars": "node scripts/fetch-sidecar-binaries.js",
    "verify:sidecars": "node scripts/verify-sidecar-binaries.js",
    "prebuild": "node scripts/verify-sidecar-binaries.js",
    "prebuild:win:x64": "node scripts/verify-sidecar-binaries.js",
    "prebuild:win:arm64": "node scripts/verify-sidecar-binaries.js",
    "prebuild:win:all": "node scripts/verify-sidecar-binaries.js",
    "prebuild:mac": "node scripts/verify-sidecar-binaries.js",
    "prebuild:linux": "node scripts/verify-sidecar-binaries.js",
    "prebuild:all": "node scripts/verify-sidecar-binaries.js",
    "test": "node test/run-tests.js",
    "build:live2d": "esbuild src/renderer/shared/live2d/live2d-cubism5-renderer.ts --bundle --platform=browser --format=iife --target=chrome120 --alias:@framework=../CubismSdkForWeb-5-r.5/Framework/src --outfile=src/renderer/shared/live2d/live2d-renderer.bundle.js",
    "build:rich-content": "esbuild src/renderer/shared/rich-content/index.js --bundle --platform=browser --format=iife --target=chrome120 --outfile=src/renderer/shared/rich-content/rich-content.bundle.js",
    "build:a2ui": "esbuild src/renderer/shared/a2ui/index.js --bundle --platform=browser --format=iife --target=chrome120 --outfile=src/renderer/shared/a2ui/a2ui.bundle.js",
    "create-theme": "node scripts/create-theme.js",
    "export-agent-icons": "node scripts/export-agent-icons.js",
    "install:claude-hooks": "node hooks/install.js",
    "uninstall:claude-hooks": "node hooks/uninstall.js",
    "install:gemini-hooks": "node hooks/gemini-install.js",
    "install:antigravity-hooks": "node hooks/antigravity-install.js",
    "install:cursor-hooks": "node hooks/cursor-install.js",
    "install:kiro-hooks": "node hooks/kiro-install.js",
    "install:kimi-hooks": "node hooks/kimi-install.js",
    "install:qwen-hooks": "node hooks/qwen-code-install.js",
    "install:codewhale-hooks": "node hooks/codewhale-install.js",
    "uninstall:codewhale-hooks": "node hooks/codewhale-install.js --uninstall",
    "install:pi-extension": "node hooks/pi-install.js",
    "uninstall:pi-extension": "node hooks/pi-install.js --uninstall",
    "install:openclaw-plugin": "node hooks/openclaw-install.js",
    "uninstall:openclaw-plugin": "node hooks/openclaw-install.js --uninstall",
    "install:codex-hooks": "node hooks/codex-install.js",
    "uninstall:codex-hooks": "node hooks/codex-install.js --uninstall",
    "install:codex-debug-hooks": "node hooks/codex-debug-install.js",
    "uninstall:codex-debug-hooks": "node hooks/codex-debug-install.js --uninstall",
    "install:hermes-plugin": "node hooks/hermes-install.js",
    "uninstall:hermes-plugin": "node hooks/hermes-install.js --uninstall",
    "install:qoder-hooks": "node hooks/qoder-install.js",
    "uninstall:qoder-hooks": "node hooks/qoder-install.js --uninstall",
    "install:reasonix-hooks": "node hooks/reasonix-install.js",
    "uninstall:reasonix-hooks": "node hooks/reasonix-install.js --uninstall",
    "cleanup:integrations": "node hooks/cleanup-integrations.js --apply",
    "register-protocol:dev": "node launch.js --register-protocol"
  },
  "keywords": [
    "tsukumate",
    "desktop-pet",
    "electron",
    "claude-code"
  ],
  "author": "Kaito-miku and TsukuMate contributors",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kaito-miku/TsukuMate--deskpet.git"
  },
  "homepage": "https://github.com/Kaito-miku/TsukuMate--deskpet",
  "upstreamRepository": "https://github.com/OpenBMB/MiniCPM-Desk-Pet",
  "type": "commonjs",
  "build": {
    "appId": "io.github.kaito-miku.tsukumate",
    "productName": "TsukuMate",
    "copyright": "Copyright © 2026 Kaito-miku and contributors. Based on OpenBMB MiniCPM Desk Pet (AGPL-3.0-only).",
    "protocols": [
      {
        "name": "TsukuMate Import Protocol",
        "schemes": [
          "tsukumate",
          "clawd"
        ]
      }
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "artifactName": "TsukuMate-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.entertainment",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "icon": "assets/icon.ico",
      "artifactName": "TsukuMate-Setup-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "maintainer": "Kaito-miku",
      "icon": "assets/icons",
      "category": "Utility",
      "artifactName": "TsukuMate-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "buildUniversalInstaller": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "include": "build/installer.nsh"
    },
    "afterSign": "scripts/notarize.js",
    "files": [
      "NOTICE.md",
      "src/**/*",
      "assets/icon.ico",
      "assets/icons/**/*",
      "assets/icons/agents/**/*",
      "assets/svg/**/*",
      "assets/sounds/**/*",
      "assets/dock-icon.png",
      "assets/tray-icon*.png",
      "hooks/**/*",
      "extensions/**/*",
      "agents/**/*",
      "themes/**/*",
      "pwa/**/*"
    ],
    "asarUnpack": [
      "assets/svg/**/*",
      "hooks/**/*",
      "extensions/**/*",
      "agents/**/*",
      "themes/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "bin/cc-connect-clawd",
        "to": "sidecars/cc-connect-clawd"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Kaito-miku",
        "repo": "TsukuMate--deskpet"
      }
    ]
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.25.12"
  },
  "dependencies": {
    "@a2ui/web_core": "^0.10.5",
    "@pixi/unsafe-eval": "^7.4.3",
    "@soullink-emotion/engine": "^0.1.0-beta.1",
    "@soullink-emotion/live2d-pixi": "^0.1.0-beta.1",
    "dompurify": "^3.4.12",
    "electron-updater": "^6.8.3",
    "htmlparser2": "^12.0.0",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "katex": "^0.16.47",
    "koffi": "^2.15.2",
    "mammoth": "^1.12.0",
    "marked": "^15.0.12",
    "mermaid": "^11.16.0",
    "morphdom": "^2.7.8",
    "pdf-parse": "^1.1.4",
    "pixi-live2d-display": "^0.5.0-beta",
    "pixi.js": "^7.4.3",
    "socks-proxy-agent": "^8.0.5",
    "three": "^0.180.0",
    "ws": "^8.21.0"
  }
}
